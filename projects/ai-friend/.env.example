# Required
OPENAI_API_KEY=sk-...
# Every device (browser or bot) must send this to connect. Use 20+ random characters.
FRIEND_ACCESS_TOKEN=change-me-to-something-long-and-random

# Optional
FRIEND_NAME=Mochi
OWNER_NAME=
VOICE=marin
REALTIME_MODEL=gpt-realtime-2.1-mini
SEARCH_MODEL=gpt-5.4-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
IDLE_SECONDS=90
MAX_SESSION_MINUTES=20
